{
  "name": "projekte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c gray,blue \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "PORT=3280 tsx watch server/index.ts",
    "dev:web": "API_PORT=3280 vite --port 5280 --strictPort",
    "dev:test": "concurrently -k -n server,web -c gray,blue \"DATA_FILE=data/items.test.json PORT=3281 tsx watch server/index.ts\" \"API_PORT=3281 vite --port 5281 --strictPort\"",
    "testdata:reset": "tsx scripts/reset-testdata.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
